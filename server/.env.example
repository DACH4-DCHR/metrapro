PGHOST=localhost
PGPORT=5432
PGDATABASE=metrapro
PGUSER=metrapro_app
PGPASSWORD=change-me

# Alternativa: si tu proveedor (Supabase, Neon, Railway, RDS...) te da un connection
# string, usa esta variable en vez de las PG* de arriba.
# DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# --- Solo en producción (ej. Railway) ---
# NODE_ENV=production activa cookies "secure" + "SameSite=None", necesarias cuando
# el frontend vive en un dominio distinto al backend (ej. Vercel + Railway).
# NODE_ENV=production

# URL exacta del frontend desplegado (sin barra final). Sin esto, la API acepta
# peticiones con credenciales desde cualquier origen (cómodo en desarrollo, menos
# estricto en producción).
# CORS_ORIGIN=https://tu-app.vercel.app

# Puerto que asigna la plataforma (Railway ya define PORT automáticamente).
# PORT=4000
